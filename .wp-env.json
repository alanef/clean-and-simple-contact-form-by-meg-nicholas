{
  "phpVersion": "8.4",
  "plugins": [
    "./clean-and-simple-contact-form-by-meg-nicholas"
  ],
  "port": 8500,
  "testsPort": 8501,
  "config": {
    "WP_DEBUG_LOG": "/var/www/html/wp-content/debug.log",
    "FWAS_DEBUG": true,
    "WP_FS__DEV_MODE": true,
    "WP_DISABLE_FATAL_ERROR_HANDLER": true,
    "JETPACK_DEV_DEBUG": true
  },
  "mappings": {
    "tests": "./tests",
    "vendor": "./vendor",
    "phpunit.xml.dist": "./phpunit.xml.dist"
  },
  "env": {
    "development": {
      "mysqlPort": 62500
    },
    "tests": {
      "mysqlPort": 62501
    }
  }
}
